# Copy to .env (sh setup.sh does it and fills in the two secrets). compose.yml reads this file.

# --- Required ---------------------------------------------------------------------------------
# Database password. Keep it: the data volume is tied to it.
POSTGRES_PASSWORD=
# Admin key for creating the first real keys (dk_ followed by 29+ characters). Remove it once you
# have an ADMIN key of your own, then run 'docker compose up -d' again.
DITEKO_AUTH_BOOTSTRAPKEY=

# --- Server image -----------------------------------------------------------------------------
# A released version. X.Y follows that line's patch releases (docker compose pull picks them up);
# X.Y.Z pins one exactly. Upgrading is changing this and running 'docker compose up -d'.
DITEKO_VERSION=0.1
# DITEKO_IMAGE=ghcr.io/lehlohonolo-sehako/diteko

# --- Where it listens -------------------------------------------------------------------------
# 127.0.0.1 keeps it on this machine. Use 0.0.0.0 only behind a TLS reverse proxy or a VPN.
DITEKO_BIND=127.0.0.1
DITEKO_PORT=8080

# --- Amazon Connect (optional) ----------------------------------------------------------------
# Without these, "Run on Connect" is a dry run and nothing reaches AWS. Running tests creates
# billable Connect test executions: point a first install at a non-production instance.
# DITEKO_CONNECT_ENABLED=true
# DITEKO_CONNECT_REGION=eu-west-2
# DITEKO_CONNECT_INSTANCEID=a1b2c3d4-...
# Hours profiles that force an hours check open or closed (optional, see README.md):
# DITEKO_CONNECT_HOURSALWAYSOPEN=arn:aws:connect:...
# DITEKO_CONNECT_HOURSNEVEROPEN=arn:aws:connect:...
# Credentials of an IAM principal with the permissions listed in README.md:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Where the console's Docs links point; an internal mirror, or empty to hide them:
# DITEKO_DOCS_URL=
